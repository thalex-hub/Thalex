rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email in ['admin@thalex.vn', 'dieuhanh@thalex.vn', 'it@thalex.vn', 'ceo@thalex.vn']
      );
    }

    function existsUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserDoc().get('roleId', 'Staff');
    }

    function getUserLegacyId() {
      return getUserDoc().get('legacyId', '');
    }

    function hasPermission(permission) {
      return isSignedIn() && (
        isDirector() ||
        (permission in getUserDoc().get('permissions', []))
      );
    }

    function isDirectorRole(role) {
      let r = role.lower();
      return r in ['superadmin', 'director', 'vicedirector', 'tổng giám đốc', 'phó tổng giám đốc', 'giám đốc', 'giám đốc điều hành', 'giám đốc tài chính', 'giám đốc kinh doanh'];
    }

    function isManagerRole(role) {
      let r = role.lower();
      return r in ['manager', 'generalmanager', 'hrmanager', 'chiefaccountant', 'salesmanager', 'technicalmanager', 'trưởng phòng', 'quản lý', 'phụ trách', 'điều hành'];
    }

    function isAccountantRole(role) {
      let r = role.lower();
      return r in ['chiefaccountant', 'accountant', 'accountantstaff', 'ketoan', 'kế toán', 'thủ quỹ'];
    }

    function isHRRole(role) {
      let r = role.lower();
      return r in ['hrmanager', 'hr', 'hrstaff', 'nhansu', 'nhân sự', 'hành chính'];
    }

    function isDirector() { 
      return isAdmin() || (existsUserDoc() && isDirectorRole(getUserRole()));
    }

    function isHR() { 
      return isDirector() || (existsUserDoc() && (isHRRole(getUserRole()) || hasPermission('manage_hr') || hasPermission('view_hr_users')));
    }

    function isManager() { 
      return isDirector() || (existsUserDoc() && (isManagerRole(getUserRole()) || hasPermission('approve_leave_requests')));
    }

    function isAccountant() { 
      return isDirector() || (existsUserDoc() && (isAccountantRole(getUserRole()) || hasPermission('manage_cashflow') || hasPermission('view_cashflow')));
    }

    function isFinanceStaff() { 
      return isDirector() || isAccountant() || (existsUserDoc() && (isAccountantRole(getUserRole()) || hasPermission('view_cashflow')));
    }

    function isOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid || 
        data.uid == request.auth.uid ||
        (existsUserDoc() && (data.userId == getUserLegacyId() || data.uid == getUserLegacyId()))
      );
    }

    function isTaskInvolved(data) {
      return isSignedIn() && (
        data.assigneeId == request.auth.uid ||
        data.assignerId == request.auth.uid ||
        data.responsibleUserId == request.auth.uid ||
        (existsUserDoc() && (
          data.assigneeId == getUserLegacyId() ||
          data.assignerId == getUserLegacyId() ||
          data.responsibleUserId == getUserLegacyId()
        ))
      );
    }

    function isTaskFollower(data) {
      return isSignedIn() && (
        (request.auth.uid in data.get('followers', [])) ||
        (existsUserDoc() && getUserLegacyId() in data.get('followers', []))
      );
    }

    // -------------------------------------------------------------------------
    // COLLECTIONS
    // -------------------------------------------------------------------------

    // Global catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connectivity
    match /test/connection {
      allow read: if true;
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isDirector() || isHR() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isDirector() || isHR() || (
        isSignedIn() && request.auth.uid == userId && 
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'avatar', 'phoneNumber', 'address', 'bio', 'preferences', 'bankAccount', 'bankName', 'bankAccountName'])
      );
      allow delete: if isAdmin() || isDirector();
    }

    match /activity_logs/{logId} {
      allow read: if isDirector() || isHR();
      allow create: if isSignedIn();
    }

    match /attendance/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isOwner(resource.data) ||
                    hasPermission('view_attendance') || hasPermission('menu_attendance_view');
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || hasPermission('manage_attendance');
      allow delete: if isDirector() || isHR();
    }

    match /tasks/{taskId} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isTaskInvolved(resource.data) || isTaskFollower(resource.data);
      allow create: if isDirector() || isManager() || isHR() || isFinanceStaff();
      allow update: if isDirector() || isFinanceStaff() || isTaskInvolved(existing());
      allow delete: if isDirector() || (isSignedIn() && existing().assignerId == request.auth.uid);
    }

    match /task_comments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /order_proposals/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() ||
                    hasPermission('view_orders') || hasPermission('menu_orders_view') ||
                    (isSignedIn() && (
                      resource.data.createdBy == request.auth.uid || 
                      (existsUserDoc() && resource.data.createdBy == getUserLegacyId()) ||
                      isTaskFollower(resource.data) ||
                      resource.data.responsibleUserId == request.auth.uid ||
                      (existsUserDoc() && resource.data.responsibleUserId == getUserLegacyId())
                    ));
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() ||
                    hasPermission('approve_orders') ||
                    (isSignedIn() && (
                      resource.data.createdBy == request.auth.uid || 
                      (existsUserDoc() && resource.data.createdBy == getUserLegacyId())
                    ));
      allow delete: if isDirector() || isHR() || isFinanceStaff();
    }

    match /orders/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() ||
                   hasPermission('view_orders') || hasPermission('menu_orders_view') ||
                   (isSignedIn() && (
                     resource.data.responsibleUserId == request.auth.uid || 
                     resource.data.responsibleUserId == getUserLegacyId() ||
                     isTaskFollower(resource.data)
                   ));
      allow create: if isDirector() || isHR() || isFinanceStaff() || hasPermission('create_orders');
      allow update: if isDirector() || isHR() || isFinanceStaff() || hasPermission('edit_orders') ||
                    (isSignedIn() && (
                     resource.data.responsibleUserId == request.auth.uid || 
                     resource.data.responsibleUserId == getUserLegacyId()
                   ));
      allow delete: if isDirector() || hasPermission('delete_orders');
    }

    match /customers/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isDirector() || isHR() || hasPermission('delete_customers');
    }

    match /departments/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR();
    }

    match /roles/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR();
    }

    match /warehouses/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isManager() || isHR() || hasPermission('manage_warehouse');
    }

    match /inventory/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isManager() || isHR() || hasPermission('manage_inventory');
    }

    match /payment_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || isOwner(resource.data) || isTaskFollower(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isFinanceStaff() || (isOwner(existing()) && existing().status == 'pending');
    }

    match /leave_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isManager() || isOwner(resource.data) || isTaskFollower(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isHR() || isManager() || (isOwner(existing()) && existing().status == 'pending');
    }

    match /business_trip_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isManager() || isOwner(resource.data) || isTaskFollower(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isHR() || isManager() || (isOwner(existing()) && existing().status == 'pending');
    }

    match /advance_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isManager() || isOwner(resource.data) || isTaskFollower(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isFinanceStaff() || (isOwner(existing()) && existing().status == 'pending');
    }

    match /reimbursement_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isManager() || isOwner(resource.data) || isTaskFollower(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isFinanceStaff() || (isOwner(existing()) && existing().status == 'pending');
    }

    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || hasPermission('manage_settings');
    }

    match /stored_files/{id} {
      allow read: if isSignedIn() && (isDirector() || isHR() || isFinanceStaff() || isOwner(resource.data) ||
                    (request.auth.uid in resource.data.get('sharedWith', [])) || 
                    (existsUserDoc() && getUserLegacyId() in resource.data.get('sharedWith', [])));
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isOwner(existing());
    }

    match /folders/{id} {
      allow read: if isSignedIn() && (isDirector() || isHR() || isFinanceStaff() || isOwner(resource.data) ||
                    (request.auth.uid in resource.data.get('sharedWith', [])) || 
                    (existsUserDoc() && getUserLegacyId() in resource.data.get('sharedWith', [])));
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isOwner(existing());
    }
  }
}
