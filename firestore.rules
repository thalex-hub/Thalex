rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Heartland Heartbeat - Allow read for everyone to test connectivity
    match /test/connection {
      allow read: if true;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    // Identity integrity
    function isOwner(data) {
        return isSignedIn() && (
        ('userId' in data && data.userId == request.auth.uid) || 
        ('createdBy' in data && data.createdBy == request.auth.uid) ||
        ('assignedTo' in data && data.assignedTo == request.auth.uid) ||
        ('assigneeId' in data && (data.assigneeId == request.auth.uid || ('email' in request.auth.token && data.assigneeId == request.auth.token.email) || ('email' in request.auth.token && data.assigneeId == request.auth.token.email.replace('@', '_').replace('.', '_')))) ||
        ('assignerId' in data && data.assignerId == request.auth.uid) ||
        ('responsibleUserId' in data && data.responsibleUserId == request.auth.uid) ||
        ('uid' in data && data.uid == request.auth.uid) ||
        ('employeeId' in data && data.employeeId == request.auth.uid) ||
        ('email' in data && 'email' in request.auth.token && data.email.lower() == request.auth.token.email.lower()) ||
        ('userEmail' in data && 'email' in request.auth.token && data.userEmail.lower() == request.auth.token.email.lower())
      );
    }

    // Role check helpers
    function existsUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleId', 'Staff');
    }

    function getUserLegacyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('legacyId', '');
    }

    function isDirectorRole(role) {
      return role in ['SuperAdmin', 'Director', 'ViceDirector'];
    }

    function isManagerRole(role) {
      return role in ['SuperAdmin', 'Director', 'ViceDirector', 'Manager', 'GeneralManager', 'HRManager', 'ChiefAccountant', 'SalesManager', 'TechnicalManager', 'ketoantruong'] || 
             role.matches('.*_Manager');
    }

    function isAccountantRole(role) {
      return role in ['SuperAdmin', 'Director', 'ViceDirector', 'ChiefAccountant', 'Accountant', 'AccountantStaff', 'ketoantruong', 'ketoan'] || 
             role.matches('.*_Accountant');
    }

    function isHRRole(role) {
      return role in ['SuperAdmin', 'Director', 'ViceDirector', 'HRManager', 'HR', 'HRStaff'] || 
             role.matches('.*_HR');
    }

    function isFinanceStaffRole(role) {
      return role in ['SuperAdmin', 'Director', 'ViceDirector', 'ChiefAccountant', 'Accountant', 'AccountantStaff', 'GeneralManager', 'Manager'] || 
             role.matches('.*_Accountant');
    }

    function isStaffRole(role) {
      return role in ['SuperAdmin', 'Director', 'ViceDirector', 'SalesStaff', 'AccountantStaff', 'TechnicalStaff', 'GeneralStaff', 'Staff'] || 
             role.matches('.*_Staff');
    }

    // Read permission for user's role from role_permissions, falling back to standard defaults if the doc doesn't exist
    function hasPermission(perm) {
      return isSignedIn() && existsUserDoc() && (
        (exists(/databases/$(database)/documents/role_permissions/$(getUserRole())) && 
         perm in get(/databases/$(database)/documents/role_permissions/$(getUserRole())).data.get('permissions', [])) ||
        // Fallback for orders
        ((perm == 'view_orders' || perm == 'menu_orders_view' || perm == 'menu_orders') && 
          (getUserRole() in ['SalesManager', 'SalesStaff', 'ChiefAccountant', 'AccountantStaff', 'Accountant', 'TechnicalManager', 'TechnicalStaff', 'GeneralStaff', 'Staff'] || 
           isManagerRole(getUserRole()) || isStaffRole(getUserRole()) || isAccountantRole(getUserRole()))) ||
        (perm == 'approve_orders' && (getUserRole() == 'SalesManager' || isManagerRole(getUserRole()))) ||
        
        // Fallback for finance
        ((perm == 'view_cashflow' || perm == 'menu_cash_flow_view' || perm == 'view_financial_reports' || perm == 'menu_business_expenses_view') && 
          (getUserRole() in ['ChiefAccountant', 'AccountantStaff', 'Accountant'] || isAccountantRole(getUserRole()))) ||
        ((perm == 'manage_cashflow' || perm == 'menu_cash_flow_edit' || perm == 'approve_disbursements' || perm == 'menu_disbursements_edit') && 
          getUserRole() in ['ChiefAccountant', 'Accountant']) ||
        
        // Fallback for proposals
        ((perm == 'view_advances' || perm == 'view_reimbursements' || perm == 'view_payment_requests' || perm == 'menu_proposals_view') && 
          (getUserRole() in ['ChiefAccountant', 'AccountantStaff', 'Accountant', 'SalesManager', 'SalesStaff', 'TechnicalManager', 'GeneralStaff', 'Staff'] || 
           isManagerRole(getUserRole()) || isStaffRole(getUserRole()) || isAccountantRole(getUserRole()))) ||
        ((perm == 'approve_advances' || perm == 'approve_reimbursements' || perm == 'approve_payment_requests') && 
          (getUserRole() in ['ChiefAccountant', 'Accountant', 'SalesManager'] || isManagerRole(getUserRole()))) ||
        ((perm == 'disburse_advances' || perm == 'disburse_reimbursements' || perm == 'disburse_payment_requests') && 
          (getUserRole() in ['ChiefAccountant', 'Accountant', 'AccountantStaff'] || isAccountantRole(getUserRole()))) ||
        
        // Fallback for HR / Users / Attendance
        ((perm == 'view_users' || perm == 'menu_hr_view' || perm == 'view_attendance' || perm == 'menu_attendance_view') && 
          (getUserRole() in ['HRManager', 'HRStaff', 'HR', 'ChiefAccountant', 'Accountant', 'AccountantStaff'] || isHRRole(getUserRole()))) ||
        ((perm == 'manage_users' || perm == 'menu_hr_edit' || perm == 'manage_attendance' || perm == 'menu_attendance_edit' || perm == 'approve_leave_requests') && 
          (getUserRole() in ['HRManager', 'HR'] || isHRRole(getUserRole()))) ||
        
        // Fallback for Tasks / Warehouse / Storage
        (perm in ['view_tasks', 'menu_tasks_view', 'view_warehouse', 'menu_warehouse_view', 'view_storage', 'menu_storage_view']) ||
        ((perm == 'manage_tasks' || perm == 'menu_tasks_edit') && 
          (getUserRole() in ['HRManager', 'HRStaff', 'HR', 'SalesManager', 'TechnicalManager'] || isManagerRole(getUserRole()))) ||
        ((perm == 'manage_warehouse' || perm == 'menu_warehouse_edit') && 
          (getUserRole() in ['ChiefAccountant', 'Accountant', 'TechnicalManager'] || isAccountantRole(getUserRole()))) ||
        ((perm == 'manage_storage' || perm == 'menu_storage_edit') && 
          (getUserRole() in ['HRManager', 'ChiefAccountant', 'TechnicalManager'] || 
           isManagerRole(getUserRole()) || isHRRole(getUserRole()) || isAccountantRole(getUserRole())))
      );
    }

    // Admin bootstrap
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email.lower() == 'thangcd11@gmail.com'.lower() || 
        request.auth.token.email.lower() == 'info.vinasglobal@gmail.com'.lower() || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (existsUserDoc() && (
          isDirectorRole(getUserRole()) || 
          getUserRole() == 'HRManager' || 
          getUserRole() == 'HR' || 
          isHRRole(getUserRole())
        ))
      ); 
    }

    function isDirector() { 
      return isSignedIn() && (
        request.auth.uid == 'vnN51rJHpdgaHtEaeCf5gxJrqLu2' ||
        ('email' in request.auth.token && request.auth.token.email.lower() == 'thangcd11@gmail.com'.lower()) || 
        ('email' in request.auth.token && request.auth.token.email.lower() == 'info.vinasglobal@gmail.com'.lower()) || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (existsUserDoc() && isDirectorRole(getUserRole()))
      );
    }

    function isManager() { 
      return isDirector() || (existsUserDoc() && (isManagerRole(getUserRole()) || hasPermission('approve_leave_requests') || hasPermission('manage_tasks'))) || request.auth.token.email == 'tuyetmai@thalex.vn'; 
    }
    
    function isAccountant() { 
      return isDirector() || (existsUserDoc() && (isAccountantRole(getUserRole()) || hasPermission('manage_cashflow'))) || request.auth.token.email == 'tuyetmai@thalex.vn'; 
    }
    
    function isHR() { 
      return isDirector() || (existsUserDoc() && (isHRRole(getUserRole()) || hasPermission('manage_users'))); 
    }
    
    function isFinanceStaff() { 
      return isDirector() || isAccountant() || (existsUserDoc() && (isFinanceStaffRole(getUserRole()) || hasPermission('manage_cashflow') || hasPermission('view_cashflow')));
    }

    // --- Entity Specific Rules ---

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isDirector() || isHR() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin() || isDirector() ||
                    (isSignedIn() && resource != null && ('email' in resource.data ? resource.data.email : '').lower() == request.auth.token.email.lower());
    }

    // Admins helper collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Attendance
    match /attendance/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || hasPermission('view_attendance') || hasPermission('menu_attendance_view') || hasPermission('view_salaries');
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || hasPermission('manage_attendance') || hasPermission('menu_attendance_edit');
      allow delete: if isDirector() || isHR();
    }

    // Tasks
    match /tasks/{taskId} {
      function isTaskLeader() { return isDirector() || isManager() || isHR(); }
      function isTaskInvolved() {
        return isSignedIn() && (
          isTaskLeader() || 
          (resource.data.assigneeId == request.auth.uid) || 
          (existsUserDoc() && resource.data.assigneeId == getUserLegacyId()) ||
          (resource.data.assignerId == request.auth.uid) ||
          (existsUserDoc() && resource.data.assignerId == getUserLegacyId()) ||
          (resource.data.responsibleUserId == request.auth.uid) ||
          (existsUserDoc() && resource.data.responsibleUserId == getUserLegacyId()) ||
          request.auth.uid in resource.data.followers ||
          (existsUserDoc() && getUserLegacyId() in resource.data.followers)
        );
      }
      
      allow read: if isDirector() || isTaskInvolved() || isFinanceStaff();
      allow create: if isTaskLeader() || isFinanceStaff();
      allow update: if isTaskInvolved() || isFinanceStaff();
      allow delete: if isTaskLeader() || (isSignedIn() && ('assignerId' in existing() ? existing().assignerId : '') == request.auth.uid);
    }

    // Task Comments
    match /task_comments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && ('userId' in existing() ? existing().userId : '') == request.auth.uid;
      allow delete: if isDirector() || isHR() || (isSignedIn() && ('userId' in existing() ? existing().userId : '') == request.auth.uid);
    }

    // Customers
    match /customers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing());
      allow delete: if isDirector() || isHR() || isFinanceStaff();
    }

    // Leave Requests
    match /leave_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || isManager() || 
                   hasPermission('approve_leave_requests') || hasPermission('menu_proposals_view') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers) ||
                   (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isManager() || isOwner(existing()) || 
                   hasPermission('approve_leave_requests') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers);
      allow delete: if isDirector() || isHR() || isOwner(existing());
    }

    // Advance, Payment, Reimbursement Requests
    match /advance_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || isManager() || 
                   hasPermission('view_advances') || hasPermission('menu_proposals_view') || hasPermission('view_salaries') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers) ||
                   (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || isManager() || 
                   hasPermission('approve_advances') || hasPermission('disburse_advances') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers);
      allow delete: if isDirector() || isFinanceStaff() || isOwner(existing());
    }
    
    match /payment_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || isManager() || 
                   hasPermission('view_payment_requests') || hasPermission('menu_proposals_view') || hasPermission('view_salaries') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers) ||
                   (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || isManager() || 
                   hasPermission('approve_payment_requests') || hasPermission('disburse_payment_requests') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers);
      allow delete: if isDirector() || isFinanceStaff() || isOwner(existing());
    }

    match /reimbursement_requests/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || isManager() || 
                   hasPermission('view_reimbursements') || hasPermission('menu_proposals_view') || hasPermission('view_salaries') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers) ||
                   (isSignedIn() && resource.data.userId == request.auth.uid) ||
                   (isSignedIn() && resource.data.advanceOwnerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || isManager() || 
                   hasPermission('approve_reimbursements') || hasPermission('disburse_reimbursements') ||
                   (isSignedIn() && request.auth.uid in resource.data.followers);
      allow delete: if isDirector() || isFinanceStaff() || isOwner(existing());
    }

    // Order Proposals
    match /order_proposals/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() ||
                    hasPermission('view_orders') || hasPermission('menu_orders_view') ||
                   (isSignedIn() && (
                     (resource.data.get('createdBy', '') == request.auth.uid) || 
                     (existsUserDoc() && resource.data.get('createdBy', '') == getUserLegacyId()) ||
                     (request.auth.uid in resource.data.get('followers', [])) ||
                     (existsUserDoc() && getUserLegacyId() in resource.data.get('followers', []))
                   ));
      allow create: if isSignedIn();
      allow update: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() ||
                    hasPermission('approve_orders') || hasPermission('menu_orders_edit') ||
                   (isSignedIn() && (
                     (resource.data.get('createdBy', '') == request.auth.uid) || 
                     (existsUserDoc() && resource.data.get('createdBy', '') == getUserLegacyId()) ||
                     (request.auth.uid in resource.data.get('followers', [])) ||
                     (existsUserDoc() && getUserLegacyId() in resource.data.get('followers', []))
                   ));
      allow delete: if isDirector() || isHR() || isFinanceStaff();
    }
    // Payments
    match /payments/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isOwner(existing()) || hasPermission('view_cashflow') || hasPermission('manage_cashflow');
      allow create: if isDirector() || isFinanceStaff() || hasPermission('manage_cashflow');
      allow update: if isDirector() || isFinanceStaff() || hasPermission('manage_cashflow');
      allow delete: if isDirector();
    }
    
    // User Activity Logs
    match /user_activity_logs/{id} {
      allow read: if isDirector() || isHR() || (isSignedIn() && ('userId' in existing() ? existing().userId : '') == request.auth.uid);
      allow create: if isSignedIn();
      allow delete: if isDirector() || isHR();
    }

    // CRM Activity
    match /customer_activities/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Task Reports
    match /task_reports/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isDirector() || isHR();
    }

    // Static data collections
    match /departments/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR(); }
    match /positions/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR(); }
    match /roles/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR(); }
    match /permissions/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR(); }
    match /role_permissions/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR(); }
    match /approvals/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR(); }
    
    // Settings
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR();
    }

    // Warehouse & Inventory
    match /warehouses/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('manage_warehouse'); }
    match /product_categories/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('manage_warehouse'); }
    match /products/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('manage_warehouse'); }
    match /inventory/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('manage_warehouse'); }
    match /stock_transactions/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('view_warehouse') || hasPermission('manage_warehouse');
      allow create: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('manage_warehouse');
      allow update: if isDirector() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('manage_warehouse');
      allow delete: if isDirector();
    }
    match /stock_items/{id} { allow read: if isSignedIn(); allow write: if isDirector() || isHR() || isFinanceStaff() || isAccountant() || isManager() || hasPermission('manage_warehouse'); }

    // Business Expenses
    match /business_expenses/{id} {
      allow read: if isDirector() || isHR() || isFinanceStaff();
      allow write: if isDirector() || isFinanceStaff();
    }

    // Files & Folders
    match /stored_files/{id} {
      allow read: if isDirector() || isHR() || (isSignedIn() && (
        ('type' in resource.data ? resource.data.type : '') == 'company' || 
        resource.data.ownerId == request.auth.uid || 
        ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith) ||
        ('sharedWith' in resource.data && 'all' in resource.data.sharedWith)
      ));
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isHR() || (isSignedIn() && ('ownerId' in existing() ? existing().ownerId : '') == request.auth.uid);
    }

    match /folders/{id} {
      allow read: if isDirector() || isHR() || (isSignedIn() && (
        ('type' in resource.data ? resource.data.type : '') == 'company' || 
        resource.data.ownerId == request.auth.uid || 
        ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith) ||
        ('sharedWith' in resource.data && 'all' in resource.data.sharedWith)
      ));
      allow create: if isSignedIn();
      allow update, delete: if isDirector() || isHR() || (isSignedIn() && ('ownerId' in existing() ? existing().ownerId : '') == request.auth.uid);
    }
  }
}
