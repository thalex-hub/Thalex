rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email in [
          'admin@thalex.vn', 
          'dieuhanh@thalex.vn', 
          'it@thalex.vn', 
          'ceo@thalex.vn', 
          'info.vinasglobal@gmail.com', 
          'vietnhan@thalex.com.vn', 
          'vietnhan@thalex.vn', 
          'thangcd11@gmail.com', 
          'vanquy@thalex.com.vn', 
          'ngocvan@thalex.com.vn', 
          'ngocvan@thalex.vn'
        ]
      );
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserDoc().roleId : '';
    }

    function getUserLegacyId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'legacyId' in getUserDoc() ? getUserDoc().legacyId : '';
    }

    function isDirector() {
      return isAdmin() || (
        isSignedIn() && (
          getUserRole() in ['Director', 'SuperAdmin', 'ViceDirector'] ||
          (request.auth.token.email != null && (
            request.auth.token.email.matches('.*dieuhanh.*') || 
            request.auth.token.email.matches('.*ceo.*') ||
            request.auth.token.email.matches('.*admin.*') ||
            request.auth.token.email in ['vietnhan@thalex.com.vn', 'vietnhan@thalex.vn', 'thangcd11@gmail.com', 'vanquy@thalex.com.vn', 'ngocvan@thalex.com.vn', 'ngocvan@thalex.vn', 'info.vinasglobal@gmail.com']
          ))
        )
      );
    }

    function isHR() {
      return isDirector() || (
        isSignedIn() && (
          getUserRole() in ['HRManager', 'HRStaff', 'HR', 'GeneralManager'] ||
          (request.auth.token.email != null && (request.auth.token.email.matches('.*hr.*') || request.auth.token.email.matches('.*nhansu.*')))
        )
      );
    }

    function isFinanceStaff() {
      return isDirector() || (
        isSignedIn() && (
          getUserRole() in ['ChiefAccountant', 'AccountantStaff', 'Accountant', 'GeneralManager'] ||
          (request.auth.token.email != null && (request.auth.token.email.matches('.*ketoan.*') || request.auth.token.email.matches('.*accountant.*') || request.auth.token.email.matches('.*finance.*')))
        )
      );
    }

    function isAccountant() {
      return isFinanceStaff();
    }

    function isManager() {
      return isDirector() || (
        isSignedIn() && (
          getUserRole() in ['Manager', 'SalesManager', 'TechnicalManager', 'GeneralManager', 'HRManager', 'ChiefAccountant']
        )
      );
    }

    function hasPermission(perm) {
      return isDirector() || (
        isSignedIn() && 
        getUserRole() != '' && 
        exists(/databases/$(database)/documents/role_permissions/$(getUserRole())) &&
        get(/databases/$(database)/documents/role_permissions/$(getUserRole())).data.permissions != null &&
        perm in get(/databases/$(database)/documents/role_permissions/$(getUserRole())).data.permissions
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (getUserLegacyId() != '' && getUserLegacyId() == userId)
      );
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isDirector() || hasPermission('manage_users');
    }

    // --- Activity Logs ---
    match /activity_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isDirector();
    }

    match /user_activity_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isDirector();
    }

    // --- Roles & Positions & Departments ---
    match /departments/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR() || hasPermission('manage_users') || hasPermission('menu_business_edit');
    }

    match /positions/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR() || hasPermission('manage_users') || hasPermission('menu_business_edit');
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR() || hasPermission('manage_users');
    }

    match /role_permissions/{roleId} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR() || hasPermission('manage_users');
    }

    // --- Attendance ---
    match /attendance/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isHR() || isDirector();
    }

    // --- Tasks ---
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isDirector() || (isSignedIn() && (resource.data.createdBy == request.auth.uid || (getUserLegacyId() != '' && resource.data.createdBy == getUserLegacyId())));
    }

    match /task_comments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isDirector() || (isSignedIn() && (resource.data.userId == request.auth.uid || (getUserLegacyId() != '' && resource.data.userId == getUserLegacyId())));
    }

    match /task_reports/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isDirector() || (isSignedIn() && (resource.data.userId == request.auth.uid || (getUserLegacyId() != '' && resource.data.userId == getUserLegacyId())));
    }

    // --- Orders ---
    match /orders/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isDirector() || isManager() || hasPermission('menu_orders_delete') || hasPermission('menu_orders');
    }

    // --- Order Proposals ---
    match /order_proposals/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isDirector() || isManager() || hasPermission('menu_orders_delete') || hasPermission('menu_orders') ||
        (isSignedIn() && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          (getUserLegacyId() != '' && (
            resource.data.createdBy == getUserLegacyId() ||
            resource.data.userId == getUserLegacyId()
          ))
        ));
    }

    // --- Customers ---
    match /customers/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isDirector() || isManager() || hasPermission('manage_customers') || hasPermission('menu_customers_delete') || hasPermission('menu_customers');
    }

    // --- Products & Warehouse ---
    match /products/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /product_categories/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /warehouses/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /inventory/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /stock_items/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /stock_transactions/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    // --- Financial Requests ---
    match /payment_requests/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isDirector() || isFinanceStaff() || isAccountant() ||
        (isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (getUserLegacyId() != '' && resource.data.userId == getUserLegacyId())
        ));
    }

    match /leave_requests/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isDirector() || isHR() ||
        (isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (getUserLegacyId() != '' && resource.data.userId == getUserLegacyId())
        ));
    }

    match /business_trip_requests/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isDirector() || isHR() ||
        (isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (getUserLegacyId() != '' && resource.data.userId == getUserLegacyId())
        ));
    }

    match /advance_requests/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isDirector() || isFinanceStaff() || isAccountant() ||
        (isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (getUserLegacyId() != '' && resource.data.userId == getUserLegacyId())
        ));
    }

    match /reimbursement_requests/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isDirector() || isFinanceStaff() || isAccountant() ||
        (isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (getUserLegacyId() != '' && resource.data.userId == getUserLegacyId())
        ));
    }

    match /business_expenses/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isDirector() || isFinanceStaff() || isAccountant() || hasPermission('menu_business_expenses_edit') || hasPermission('menu_business_expenses');
    }

    match /payments/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isDirector() || isFinanceStaff() || isAccountant() || hasPermission('menu_cash_flow_edit') || hasPermission('menu_cash_flow');
    }

    // --- Files & Storage ---
    match /stored_files/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isDirector() || isHR() || (isSignedIn() && (resource.data.uploadedBy == request.auth.uid || (getUserLegacyId() != '' && resource.data.uploadedBy == getUserLegacyId())));
    }

    match /folders/{id} {
      allow read, write: if isSignedIn();
    }

    // --- Settings & Diagnostics ---
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isDirector() || isHR();
    }

    match /test/{id} {
      allow read, write: if isSignedIn();
    }

    // --- Catch-all fallback ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
